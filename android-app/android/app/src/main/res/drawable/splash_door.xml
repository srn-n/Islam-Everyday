<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen icon (Nov 2026): the doorway and horizon, 120dp wide and centred, in the accent colour. The page's
     splash draws the same doorway at the same size and place (app.css, html.native .sp-door), so the launch screen
     hands over to the page without an empty moment. Coordinates are the web SVG's (viewBox 96 76 320 348) x 0.375.
     16 Nov 2026 (Notion: "the starting animation must not stick on a still page even for a second"): Android 12 and
     later play it while the app starts: the arch draws itself from foot to foot and the horizon spreads out from the
     middle (0.7 s), ending on exactly the empty doorway the page's opening begins with. At rest (Android 11 and older,
     which show the icon still) the drawable is the whole doorway. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="288dp" android:height="288dp" android:viewportWidth="288" android:viewportHeight="288">
            <group android:scaleX="0.375" android:scaleY="0.375" android:translateX="48" android:translateY="50.25">
                <path android:name="arch" android:pathData="M150,392V248A140,140 0,0 1,256 112.2A140,140 0,0 1,362 248V392"
                    android:strokeColor="@color/launch_accent" android:strokeWidth="20" android:strokeLineJoin="round" android:strokeLineCap="round" />
                <path android:name="ground" android:pathData="M118,393H394" android:strokeColor="@color/launch_accent" android:strokeWidth="20" android:strokeLineCap="round" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="arch">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="ground">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="trimPathStart" android:valueFrom="0.5" android:valueTo="0" android:duration="450"
                    android:startOffset="200" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0.5" android:valueTo="1" android:duration="450"
                    android:startOffset="200" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
