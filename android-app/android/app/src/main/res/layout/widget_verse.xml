<?xml version="1.0" encoding="utf-8"?>
<!-- Verse for today widget (VerseWidget). Colours and text are set from the app's data (WidgetData). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:id="@+id/wg_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/wg_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#0E6B5C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- The whole verse is in the app; a long one is cut here with "…" and a tap opens it. -->
        <TextView
            android:id="@+id/wg_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:textColor="#14211D"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/wg_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#5F6B66"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wg_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/wg_empty"
        android:textColor="#14211D"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
