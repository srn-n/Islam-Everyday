<?xml version="1.0" encoding="utf-8"?>
<!-- Large Verse for today widget (VerseWidgetLarge, 4x4): the same as widget_verse with more room and bigger text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:id="@+id/wg_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/wg_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#0E6B5C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- The whole verse is in the app; a long one is cut here with "…" and a tap opens it. -->
        <TextView
            android:id="@+id/wg_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.25"
            android:textColor="#14211D"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/wg_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#5F6B66"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wg_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/wg_empty"
        android:textColor="#14211D"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
