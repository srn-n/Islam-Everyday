<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight, so the page's prefers-color-scheme follows the phone's light/dark setting. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>

    <!-- Launch screen: the ground colour with the doorway in the centre (drawable/splash_door). The page's own splash
         shows the same doorway in the same place, so the opening is one continuous picture with no empty moment. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_door</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/ground</item>
        <!-- Android 11 and older draw their launch picture before the app runs, in the PHONE's light or dark colour;
             an app cannot change that. So no launch picture is drawn there: the first thing on screen is the app's own
             first frame, which MainActivity colours from the appearance chosen in the app. (values-v31 keeps it.) -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- Home-screen widget: one cell of the five prayer times -->
    <style name="WidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="WidgetCellName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#5F6B66</item>
    </style>
    <style name="WidgetCellTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#14211D</item>
    </style>
</resources>
