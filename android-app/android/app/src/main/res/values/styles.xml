<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight, so the page's prefers-color-scheme follows the phone's light/dark setting. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>

    <!-- Launch screen: the ground colour with the doorway in the centre (drawable/splash_door). The page's own splash
         shows the same doorway in the same place, so the opening is one continuous picture with no empty moment. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_door</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
