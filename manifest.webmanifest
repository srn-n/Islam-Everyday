{
  "name": "Islam Everyday",
  "short_name": "Islam Everyday",
  "description": "Prayer times and tracker, prayer guide, Qur'an with English and Bangla translations, Qur'an study and stories, duas, Hijri calendar and 99 Names. Private and offline.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#EEF3F1",
  "theme_color": "#0E6B5C",
  "icons": [
